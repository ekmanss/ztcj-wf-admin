{
  "name": "@ztcj/api",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.1.3 <12"
  },
  "scripts": {
    "dev": "nest start --watch --config nest-cli.json",
    "start:dev": "nest start --watch --config nest-cli.json",
    "start": "node dist/main.js",
    "build": "nest build --config nest-cli.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.22",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.22",
    "@nestjs/platform-express": "^11.1.22",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.15.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.21",
    "@types/node": "^25.6.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  }
}
