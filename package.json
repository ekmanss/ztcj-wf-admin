{
  "name": "ztcj-wf-admin",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.1.3 <12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:admin": "pnpm --filter @ztcj/admin dev",
    "dev:api": "pnpm --filter @ztcj/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "ci": "pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2"
  }
}
